[Unit]
Description=ISO2GOD headless store worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iso2god-worker
Group=iso2god-worker
WorkingDirectory=/var/lib/iso2god-worker
Environment=XDG_CONFIG_HOME=/var/lib/iso2god-worker/config
EnvironmentFile=/etc/iso2god-worker.env
ExecStart=/opt/iso2god-worker/iso2god --store-worker-service
Restart=on-failure
RestartSec=5
CPUQuota=200%
MemoryMax=6G
TasksMax=256
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/iso2god-worker
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
